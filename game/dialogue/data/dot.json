                "won_plain"
            ]
        },
        "won_hook": {
            "do": {
                "give": "Hook",
                "quest": {
                    "step": [
                        "hook",
                        "return"
                    ]
                }
            },
            "lines": [
                {
                    "id": "dot_14",
                    "who": "dot",
                    "pose": "shocked",
                    "text": "Oh, son of a biscuit. You actually did it."
                },
                {
                    "id": "dot_15",
                    "who": "dot",
                    "pose": "neutral",
                    "text": "Fine, fine. Here's the Hook. Tell the old grump it's a bit floury. That's a feature."
                }
            ]
        },
        "won_plain": {
            "do": {
                "gold_piles": 2
            },
            "lines": [
                {
                    "id": "dot_16",
                    "who": "dot",
                    "pose": "shocked",
                    "text": "Again?! Your memory's scary. Here, take your coins."
                },
                {
                    "id": "dot_17",
                    "who": "dot",
                    "pose": "annoyed",
                    "text": "Son of a scone. Fine. Paid. Happy?"
                },
                {
                    "id": "dot_18",
                    "who": "dot",
                    "pose": "smile",
                    "text": "Not bad. You'd make a decent baker. Terrible hours, though."
                }
            ],
            "random_line": true
        },
        "lost": {
            "lines": [
                {
                    "id": "dot_19",
                    "who": "dot",
                    "pose": "grin",
                    "text": "Ha! Time's up. Better luck next time, sweetcheeks. Kidding. Again tomorrow?"
                },
                {
                    "id": "dot_20",
                    "who": "dot",
                    "pose": "smile",
                    "text": "Close one. You've got the memory of a goldfish. A clever goldfish, but still."
                },
                {
                    "id": "dot_21",
                    "who": "dot",
                    "pose": "tired",
                    "text": "That's how I feel at four in the morning. Want another go?"
                }
