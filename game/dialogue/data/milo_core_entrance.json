{
    "_comment": "Milo in front of the way up to the Core (after the Garden boss). Warns about the hazardous place. Next time they meet, he is the boss.",
    "partner": "milo",
    "start": [
        {
            "if": {
                "flag": "talked:milo_core_entrance"
            },
            "goto": "again"
        },
        "first"
    ],
    "nodes": {
        "first": {
            "do": {
                "flag": "talked:milo_core_entrance"
            },
            "lines": [
                {
                    "id": "milo_core_entrance_01",
                    "who": "milo",
                    "pose": "serious",
                    "text": "Stop. Just for a second. Please."
                },
                {
                    "id": "milo_core_entrance_02",
                    "who": "milo",
                    "pose": "serious",
                    "text": "Up there is the Core. It's not a place for people. It was never meant to be."
                },
                {
                    "id": "milo_core_entrance_03",
                    "who": "milo",
                    "pose": "pointing",
                    "text": "It's hot. Pipes that burst, cables that bite, machines that don't care if you're standing where they move."
                },
                {
                    "id": "milo_core_entrance_04",
                    "who": "milo",
                    "pose": "neutral",
                    "text": "The air hums. After a while you start humming with it. Don't."
                },
                {
                    "id": "milo_core_entrance_05",
                    "who": "milo",
                    "pose": "serious",
                    "text": "And the things that live there... they aren't monsters. They're parts. Parts don't stop."
                },
                {
                    "who": "player",
                    "pose": "serious",
                    "text": "Why are you telling me this?"
                },
                {
                    "id": "milo_core_entrance_06",
                    "who": "milo",
                    "pose": "sad",
                    "text": "Because I want you to come back. And people who go up there without knowing don't."
                },
                {
                    "id": "milo_core_entrance_07",
                    "who": "milo",
                    "pose": "tired",
                    "text": "If you go up, bring your best. Your very best. And maybe turn around halfway."
                }
            ],
            "then": "hub"
        },
        "hub": {
            "lines": [
                {
                    "id": "milo_core_entrance_08",
                    "who": "milo",
                    "pose": "neutral",
                    "text": "..."
                }
            ],
            "choices": [
                {
                    "text": "What's at the end of the Core?",
                    "goto": "end_q"
                },
                {
                    "text": "Come with me.",
                    "goto": "come"
                },
                {
                    "text": "I'm going.",
                    "goto": "bye"
                }
            ]
        },
        "end_q": {
            "do": {
                "flag": "milo_core:end"
            },
            "lines": [
                {
                    "id": "milo_core_entrance_09",
                    "who": "milo",
                    "pose": "serious",
                    "text": "The heart of everything."
                },
                {
                    "id": "milo_core_entrance_10",
                    "who": "milo",
                    "pose": "sad",
                    "text": "And someone who'll ask you to stop. One last time."
                }
            ],
            "then": "hub"
        },
        "come": {
            "do": {
                "flag": "milo_core:come"
            },
            "lines": [
                {
                    "id": "milo_core_entrance_11",
                    "who": "milo",
                    "pose": "sad",
                    "text": "Ha. No. I'll be there. Just... not like that."
                }
            ],
            "then": "hub"
        },
        "bye": {
            "lines": [
                {
                    "id": "milo_core_entrance_12",
                    "who": "milo",
                    "pose": "tired",
                    "text": "Okay. Okay."
                },
                {
                    "id": "milo_core_entrance_13",
                    "who": "milo",
                    "pose": "sad",
                    "text": "Goodbye, outsider."
                }
            ]
        },
        "again": {
            "random_line": true,
            "lines": [
                {
                    "id": "milo_core_entrance_14",
                    "who": "milo",
                    "pose": "tired",
                    "text": "Still here. Good. Stay a little longer."
                },
                {
                    "id": "milo_core_entrance_15",
                    "who": "milo",
                    "pose": "thinking",
                    "text": "The hum is louder today. Can you hear it?"
                },
                {
                    "id": "milo_core_entrance_16",
                    "who": "milo",
                    "pose": "serious",
                    "text": "Bring your best. I mean it."
                }
            ],
            "choices": [
                {
                    "text": "What's at the end of the Core?",
                    "goto": "end_q"
                },
                {
                    "text": "Bye.",
                    "goto": "end"
                }
            ]
        }
    }
}
